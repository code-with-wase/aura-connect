{
  "appId": "com.aura.connect",
  "appName": "Aura Connect",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "hostname": "localhost"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0
    },
    "StatusBar": {
      "style": "dark",
      "backgroundColor": "#000000"
    }
  },
  "cordova": {
    "preferences": {
      "ScrollEnabled": "false",
      "BackupWebStorage": "none",
      "DisallowOverscroll": "true",
      "Orientation": "portrait"
    }
  }
}
